import java.io.*;
import java.util.*;


public class Main {
    public static void SecondLargest(int[] arr, int n) {
       int max=arr[0];
       int idx=0;
       for(int i=0; i<n; i++){
        if(max<arr[i]){
            max=arr[i];
            idx=i;
        }
       }
       int second_max=Integer.MIN_VALUE;
       for(int i=0; i<n; i++){
        if(i!=idx & second_max<arr[i]){
            second_max=arr[i];
        }
       }
       System.out.print(second_max);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n= sc.nextInt();
        int[] arr= new int[n];

        for(int i=0;i<n;i++)
            arr[i]=sc.nextInt();
            
        SecondLargest(arr,n);
        sc.close();
        
    }
}