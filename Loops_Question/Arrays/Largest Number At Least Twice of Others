import java.util.*;

class Solution {
    public int LargestElement(int[] nums, int n) {
        int max=Integer.MIN_VALUE;
        int idx=0;
        for(int i=0; i<n; i++){
            if(nums[i]>max){
                max=nums[i];
                idx=i;
            }
        
        }        
      
        for(int j=0;j<n; j++){
            if(j!=idx & max<2*nums[j]){
                return -1;
               
                
            }
        
        }
        return idx;
        
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n;
        n = sc.nextInt();
        int[] nums = new int[n];

        for(int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }

        Solution Obj = new Solution();
        System.out.println(Obj.LargestElement(nums, n));
    }
}